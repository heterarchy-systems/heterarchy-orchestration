{
  "name": "@heterarchy/control-panel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "node scripts/clean-build-artifacts.mjs all",
    "dev": "npm run clean && npm run build:legacy && next dev",
    "build:legacy": "tsc -p tsconfig.legacy.json",
    "typecheck": "tsc --noEmit",
    "build:next": "node scripts/clean-build-artifacts.mjs next && next build",
    "verify:sync": "node scripts/verify-export-sync.mjs",
    "verify:lock": "node scripts/verify-lock.mjs",
    "build": "npm run clean && npm run build:legacy && npm run build:next && node scripts/sync-export.mjs",
    "check": "npm run clean && npm run build:legacy && npm run typecheck && npm run build:next && npm run verify:sync"
  },
  "dependencies": {
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "typescript": "5.9.3"
  }
}
