# Reference values for the headless Orchestration backend.
# The daemon does not load this file, and launchd does not read env files.
# Copy only the needed key/value pairs into the LaunchAgent's
# EnvironmentVariables dictionary, or have an operator-maintained wrapper
# explicitly source a protected copy. Keep that copy user-owned and mode 0600.

# Required absolute path to the user's daemon-owned operational data root.
# This is separate from the existing app-global token catalog and Keychain.
HETERARCHY_ORCHESTRATION_DATA_DIR=/Users/your-account/.local/share/heterarchy-orchestration

# Optional loopback listener override (default: 127.0.0.1:8798).
#HETERARCHY_ORCHESTRATION_BACKEND_ADDR=127.0.0.1:8798

# Optional explicit creation of an empty authority by the daemon.
# This does not issue a bearer. Prefer the documented token issue CLI, then
# leave this unset for normal service starts; never use it as recovery.
#HETERARCHY_ORCHESTRATION_TOKEN_BOOTSTRAP=initialize

# Optional exact operator token identities. Use the non-secret token ID
# printed by `backend token issue` as `token:<uuid>`; never place the bearer
# secret in this setting.
#HETERARCHY_ORCHESTRATION_OPERATOR_PRINCIPALS=token:01900000-0000-7000-8000-000000000000

# Optional absolute path to the host-trusted Forge source configuration.
# Keep that configuration user-owned and restrict its permissions.
#HETERARCHY_ORCHESTRATION_FORGE_SOURCE_CONFIG=/Users/your-account/.config/heterarchy-orchestration/forge-source.json
