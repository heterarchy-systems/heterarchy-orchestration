{
  "manifest_version": 3,
  "name": "Heterarchy ChatGPT Companion",
  "version": "0.1.3",
  "description": "Browser runtime adapter for Heterarchy ChatGPT Agent provisioning.",
  "permissions": [
    "nativeMessaging",
    "alarms",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "key": "",
  "minimum_chrome_version": "116"
}